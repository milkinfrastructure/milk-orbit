# Publish source and reproducible build inputs, never the local development history.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/LICENSE
!/LICENSES/
!/THIRD_PARTY_NOTICES.md
!/CONTRIBUTING.md
!/Package.swift
!/Package.resolved
!/Sources/
!/Tests/
!/Config/
/Config/*
!/Config/App.xcconfig
!/Config/Info.plist
!/Config/PrivacyInfo.xcprivacy
!/Config/LaunchScreen.storyboard
!/Config/Local.xcconfig.example
!/MilkOrbit.xcodeproj/
/MilkOrbit.xcodeproj/*
!/MilkOrbit.xcodeproj/project.pbxproj
!/MilkOrbit.xcodeproj/xcshareddata/
/MilkOrbit.xcodeproj/xcshareddata/*
!/MilkOrbit.xcodeproj/xcshareddata/xcschemes/
/MilkOrbit.xcodeproj/xcshareddata/xcschemes/*
!/MilkOrbit.xcodeproj/xcshareddata/xcschemes/MilkOrbit.xcscheme
!/scripts/
/scripts/*
!/scripts/build-ios.sh
!/scripts/check.sh
!/scripts/validate-project.swift
!/scripts/select-simulator.py
!/scripts/run-simulator.sh
!/.github/
/.github/*
!/.github/workflows/
/.github/workflows/*
!/.github/workflows/ios.yml

# Defense in depth inside included directories.
.DS_Store
xcuserdata/
*.xcuserstate
.build/
.swiftpm/
*DerivedData/
*.xcarchive/
*.xcresult/
*.ipa
__pycache__/
*.pyc
.env
.env.*
*.p8
*.p12
*.pfx
*.pem
*.key
*.cer
*.mobileprovision
*.provisionprofile
*.keychain*
